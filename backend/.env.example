# ===================================================
# Database Configuration (PostgreSQL only)
# ===================================================
DB_URL=jdbc:postgresql://localhost:5432/bss_db
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# ===================================================
# Initial Admin Credentials (Never commit real credentials)
# ===================================================
BSS_ADMIN_EMAIL=admin@bsssuraksha.com
BSS_ADMIN_PASSWORD=your_secure_admin_password_here
BSS_ADMIN_NAME=BSS Super Admin
BSS_ADMIN_PHONE=+91 96641 54689

# ===================================================
# JWT Configuration
# ===================================================
JWT_SECRET=your_base64_or_hex_encoded_256_bit_secret_key_here
JWT_EXPIRATION=86400000

# ===================================================
# CORS Allowed Origins
# ===================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
